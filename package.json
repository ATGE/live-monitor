{
  "name": "hfs-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Kanban board that monitors GitHub issue assignments on HeliosSoftware/hfs and drives worktree-based fixes with Claude Code",
  "type": "module",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File stop.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File restart.ps1",
    "dev:server": "node server/src/index.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "test": "node --test server/test/*.test.mjs",
    "decisions:build": "node tools/decisions/extract.mjs",
    "decisions:check": "node tools/decisions/extract.mjs --check",
    "docs:stale": "node tools/docs/stale.mjs",
    "docs:anchors": "node tools/docs/anchors.mjs",
    "prompts:baseline": "node tools/prompt-baseline/baseline.mjs freeze",
    "prompts:baseline:dump": "node tools/prompt-baseline/baseline.mjs dump",
    "metrics:baseline": "node tools/metrics/baseline.mjs",
    "metrics:subagents": "node tools/metrics/subagents.mjs",
    "install:all": "npm install --prefix server && npm install --prefix web"
  }
}
